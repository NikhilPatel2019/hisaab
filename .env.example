# Don't edit by hand — run `make setup` (or `make docker-setup`) and it writes .env for you.
# Shown here so you know what each setting does.

# Where your data lives. Any one of:
#   sqlite:///./data/hisaab.db                                   (default, nothing to install)
#   postgresql://user:password@host:5432/hisaab                  (your own Postgres)
#   postgresql://postgres:password@db.YOURPROJECT.supabase.co:5432/postgres   (your Supabase)
#   mysql://user:password@host:3306/hisaab                       (MySQL or MariaDB)
# Special characters in passwords must be URL-encoded (% → %25, @ → %40).
HISAAB_DATABASE_URL=sqlite:///./data/hisaab.db

# 127.0.0.1 = only this computer. 0.0.0.0 = other devices too (needs a password).
HISAAB_HOST=127.0.0.1
HISAAB_PORT=8000

# Created by setup. Never share them; anyone with these can read your data.
HISAAB_PASSWORD_HASH=
HISAAB_SESSION_SECRET=
HISAAB_SECRET_KEY=

# Set to true when served over HTTPS (the compose "server" profile does this).
HISAAB_COOKIE_SECURE=false

# Only for Docker: your domain for automatic HTTPS, and bundled database passwords.
HISAAB_DOMAIN=
POSTGRES_PASSWORD=
MYSQL_PASSWORD=
